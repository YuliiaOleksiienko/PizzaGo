@model PizzaGo.DTOs.Responses.CartPageResponse

<div class="container mt-5">
    <h2 class="mb-4"><i class="bi bi-cart3"></i> Your Shopping Cart</h2>

    @if (Model.Items == null || !Model.Items.Any())
    {
        <div class="alert alert-light shadow-sm text-center py-5">
            <h4 class="text-muted">Your cart is empty</h4>
            <p>Looks like you haven't added any pizza yet.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-danger mt-3">Back to Menu</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body p-0">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                            <tr>
                                <th class="ps-4">Product</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Subtotal</th>
                                <th></th>
                            </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <img src="@item.ImageUrl" alt="@item.Name"
                                                    style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px;" class="me-3">
                                                <span class="fw-bold">@item.Name</span>
                                            </div>
                                        </td>
                                        <td class="fw-bold">@item.SubTotal.ToString("F2") €</td>
                                        <td class="text-end pe-4">
                                            <form asp-controller="CartPage" asp-action="Remove" asp-route-id="@item.PizzaId" method="post">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash"></i> Delate
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col -lg-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h5 class="card-title mb-4">Order Summary</h5>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Subtotal:</span>
                            <span>@Model.GrandTotal.ToString("F2") €</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Delivery:</span>
                            <span class="text-success fw-bold">Free</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="h5">Total:</span>
                            <span class="h5 fw-bold text-danger">@Model.GrandTotal.ToString("F2") €</span>
                            </div>

                            <button class="btn btn-danger btn-lg w-100 shadow-sm shadow-danger">
                                Checkout & Order Now
                            </button>
                        </div>
                    </div>
                </div>
            </div>
    }
</div>