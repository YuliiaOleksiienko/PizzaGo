@model IEnumerable<PizzaGo.DTOs.Responses.PizzaResponse>

<div class="container">
    <h2 class="my-4 text-center"> Our Pizza Menu</h2>

    <div class= "row" style ="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px;">

    @foreach (var pizza in Model)
    {
        <div class="card shadow-sm" style="border: 1px solid #ddd; padding: 15px; border-radius: 8px; display: flex; flex-direction: column; height: 100%; ">
            <img src = "@pizza.ImageUrl" alt="@pizza.Name" style="width: 100%; height: 200px; object-fit: cover; border-radius: 4px;" />
            <h3 style="margin-top: 10px;">@pizza.Name</h3>
            <p style="color: #666; font-size: 0.9em; flex-grow: 1;">@pizza.Description</p>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 15px;">
                <span style="font-weight: bold; font-size: 1.2em; color: #040a06;">@pizza.Price.ToString("F2") €</span>

                <button class="btn btn-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#pizzaModal"
                    onclick="prepareModal(@pizza.Id, '@pizza.Name', @pizza.Price.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                  Order Now
                </button>
            </div>
        </div>
    }
    </div>
</div>

<div class="modal fade" id="pizzaModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalPizzaName">Pizza Name</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form hx-post="/Cart/Add"
                  hx-target="#cart-badge"
                  hx-swap="innerHTML"
                  hx-on::after-request="closeModal()">

                <div class="modal-body">
                    <input type="hidden" name="PizzaId" id="modalPizzaId">

                    <div class="text-center mb-3">
                        <span class="badge bg-secondary fs-5">Price: <span id="modalPizzaPrice">0</span> €</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">How many?</label>
                        <input type="number" name="Quantity" class="form-control" value="1" min="1">
                    </div> 
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Confirm</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function prepareModal(id, name, price){
            document.getElementById('modalPizzaId').value = id;
            document.getElementById('modalPizzaName').innerText = name;
            document.getElementById('modalPizzaPrice').innerText = price;
}

        function closeModal(){
            var modalElement = document.getElementById('pizzaModal');
            var modalInstance = bootstrap.Modal.getInstance(modalElement);
            if(modalInstance){
                modalInstance.hide();
            }
        }
</script> 
}


