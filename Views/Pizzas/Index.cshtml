@model IEnumerable<PizzaGo.DTOs.Responses.PizzaResponse>

<div class="container">
    <h2 class="my-4 text-center"> Our pizza Menu</h2>

    <div class= "row" style ="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px;">

    @foreach (var pizza in Model)
    {
        <div class="card shadow-sm" style="border: 1 px solid #ddd; padding: 15px; border-radius: 8px;">
            <img src = "@pizza.ImageUrl" alt="@pizza.Name" style="width: 100%; height: 200px; object-fit: cover; border-radius: 4px;" />
            <h3 style="margin-top: 10px;">@pizza.Name</h3>
            <p style="color: #666; font-size: 0.9em;">@pizza.Description</p>
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <span style="font-weight: bold; font-size: 1.2em: color: #2ecc71;">@pizza.Price.ToString("F2") $</span>

                <button hx-get="api/orders/modal/pizza.Id"
                        hx-target="body"
                        hx-swap="beforeend"
                        class="btn btn-danger"
                        style="cursor: pointer;">
                    Order Now
                </button>
            </div>
        </div>
    }
    </div>
</div>
