@model PizzaGo.DTOs.Responses.OrderConfirmationResponse

@{
    ViewData["Title"] = "Order Success";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-lg">
        <div class="card-body p-5 text-center">
            <div class="mb-4">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
            </div>
            <h1 class="display-4 fw-bold text-success">Thank you for your order!</h1>
            <p class="lead text-muted">We have already started preparing your delicious pizza.</p>
            
            <hr class="my-4">

            <div class="row justify-content-center">
                <div class="col-md-6 text-start">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Order Number:</span>
                            <span class="fw-bold">#@Model.OrderId</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Date:</span>
                            <span>@Model.OrderDate.ToString("dd.MM.yyyy HH:mm")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Total Amount:</span>
                            <span class="text-primary fw-bold">@Model.TotalAmount.ToString("C")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Status:</span>
                            <span class="badge bg-info text-dark">@Model.Status</span>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="mt-5">
                <a asp-controller="Pizza" asp-action="Index" class="btn btn-outline-primary btn-lg px-4 me-md-2">Back to Menu</a>
                <a asp-controller="Order" asp-action="MyOrders" class="btn btn-primary btn-lg px-4">My Orders</a>
            </div>
        </div>
    </div>
</div>